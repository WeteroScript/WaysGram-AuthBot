# Telegram bot token from BotFather
BOT_TOKEN=

# Optional MTProto access to the complete Telegram StarGift catalog.
# Create an application at https://my.telegram.org and keep the API hash secret.
# Both values are required. The bot token is used for bot authorization; no user session is used.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram numeric ID allowed to use /admin
ADMIN_ID=8888957702

# Long random secret for /internal/v1/* endpoints
INTERNAL_API_TOKEN=

# Optional HMAC secret shared with the self-hosted MTProto OTP webhook sender.
# Must match TELESRV_OTP_WEBHOOK_SECRET on that server.
TELESRV_OTP_WEBHOOK_SECRET=

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this exact key across restarts.
OTP_FERNET_KEY=

# Docker Compose stores the SQLite database in the named waysgram_data volume.
DATABASE_PATH=/data/waysgram_authbot.sqlite3
# Second SQLite file for messages, groups, channels, gifts and media index.
# Leave empty to use <DATABASE_PATH name>_messenger.sqlite3 next to the main file.
MESSENGER_DATABASE_PATH=
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_PORT=8081
PORT=8081
LOG_LEVEL=INFO
